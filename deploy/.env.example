# MediaForge 部署配置 / deployment config
# 用法：cp .env.example .env 然后修改下面标注“必须修改”的项。
# Usage: cp .env.example .env, then edit the items marked "REQUIRED" below.

# 镜像地址（默认已指向阿里云公开仓库，一般不用改）。
# Image address (defaults to the public Alibaba Cloud registry; usually no need to change).
FSM_IMAGE_NAME=crpi-d1fqcfhokj0htk9o.cn-shenzhen.personal.cr.aliyuncs.com/mediafore/mediaforge:latest

# 容器名，一般不用改。
FSM_CONTAINER_NAME=mediaforge

# 【必须修改 / REQUIRED】主密钥。随便写一串复杂密钥，第一次安装后不要更换。
# Master key. A long random string. DO NOT change after first run.
FSM_MASTER_KEY=自己随便写一串复杂密钥

# 【必须修改 / REQUIRED】Web 登录会话密钥。随便写一串复杂密钥。
# Web session secret. A long random string.
FSM_SESSION_SECRET=自己随便写一串复杂密钥

# 【必须修改 / REQUIRED】播放入口 token，保护 STRM/302/代理播放入口。
# Playback token protecting the STRM/302/proxy entry.
FSM_PROXY_TOKEN=自己随便写一串复杂token

# 【必须修改 / REQUIRED】宿主机媒体挂载目录：网盘挂载到本地后真实文件显示在这里。
# Host media mount root: where mounted cloud files appear.
# 普通Linux例:/opt/mediaforge/media  群晖例:/volume1/docker/mediaforge/media  威联通例:/share/Container/mediaforge/media
FSM_MEDIA_HOST_PATH=你的宿主机媒体挂载目录

# 【必须修改 / REQUIRED】宿主机 STRM/NFO 输出目录：生成的 .strm/.nfo 保存在这里。
# Host STRM/NFO output dir.
# 普通Linux例:/opt/mediaforge/strm  群晖例:/volume1/docker/mediaforge/strm
FSM_STRM_HOST_PATH=你的宿主机strm和nfo输出目录

# 程序运行数据目录（配置/缓存/加密后的账号凭证）。一般不用改，默认当前目录 ./data。
# Runtime data dir. Defaults to ./data next to this file.
FSM_DATA_HOST_PATH=./data

# 容器内路径，一般不用改（Web 界面里填路径时用的就是这两个）。
# Container-internal paths (use these in the Web UI). Usually no change.
FSM_MEDIA_CONTAINER_PATH=/mnt/media
FSM_STRM_CONTAINER_PATH=/strm

# 端口，一般不用改。Web 界面 7860，302 播放网关 17860。
FSM_HTTP_LISTEN=:7860
FSM_PROXY_LISTEN=:17860

# FUSE 挂载传播方式，一般不用改（真实挂载到宿主机本地可见需要 rshared）。
FSM_MEDIA_BIND_PROPAGATION=rshared

# Docker 内外网回环规则，一般不用改；仅当宿主机内核不支持相关 iptables 规则时改 false。
FSM_DOCKER_HAIRPIN_FIX_ENABLED=true
